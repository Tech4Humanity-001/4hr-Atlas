# T4H Atlas ENH — copy to .env and fill

APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8080

# sqlite for local; Postgres for staging/production
# DATABASE_URL=postgresql+psycopg2://atlas:atlas@db:5432/t4h_atlas
DATABASE_URL=sqlite:///./data/atlas.db

# Required in production
ATLAS_API_KEY=

# Optional portal adapters
GRANTCONNECT_API_KEY=
UKRI_API_KEY=
HORIZON_PORTAL_TOKEN=

# Refresh cadence (hours)
REFRESH_OPEN_CALLS_HOURS=168
REFRESH_PATTERN_FUNDERS_HOURS=720

# Seed data paths (defaults point at packaged data/)
TAXONOMY_INDEX_PATH=./data/taxonomy_grant_index.json
OPPORTUNITIES_SEED_PATH=./data/opportunities.json

CORS_ORIGINS=*
